<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.alephcom.teams</groupId>
  <artifactId>cucm-jtapi</artifactId>
  <version>0.1.0</version>
  <name>cucm-jtapi</name>
  <description>CUCM JTAPI line-state sidecar for teams-sip-blf</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <dependencies>
    <!--
      Place Cisco JTAPI jars from CUCM Application → Plugins (CiscoJTAPILinux.zip)
      into lib/. At minimum jtapi.jar is required; add any companion jars from the zip.
    -->
    <dependency>
      <groupId>local.cisco</groupId>
      <artifactId>jtapi</artifactId>
      <version>15</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/jtapi.jar</systemPath>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.alephcom.teams.cucmjtapi.Main</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>com.alephcom.teams.cucmjtapi.Main</mainClass>
          <classpathScope>compile</classpathScope>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
